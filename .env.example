# ==============================================================================
# ERP IOT SIMULATOR - ENVIRONMENT CONFIGURATION (DEV/STAGING ONLY)
# ==============================================================================
#
# NOTE: This microservice is strictly ephemeral and blocked in production.
# ==============================================================================

ENVIRONMENT=dev
SERVER_PORT=8089
LOG_LEVEL=INFO

# Target Ingestion Microservice
INGESTION_URL=http://localhost:8087/api/v1/iot/telemetry
DEVICE_KEY=test-device-key
TENANT_ID=00000000-0000-0000-0000-000000000001

# Simulation Pacing & Reproducibility
DEFAULT_VEHICLES=10
DEFAULT_RATE_LIMIT=50
DEFAULT_BURST_BATCH_SIZE=100
DEFAULT_RANDOM_SEED=42

# HTTP Client Pool
HTTP_POOL_CONNECTIONS=100
HTTP_TIMEOUT_SECONDS=5.0
